# Copiez en « .env » (non versionné). Même dépôt pour le local et la prod :
# — Production : ce fichier sur le serveur OU variables dans le panneau d’hébergement (prioritaires).
# — Développement : ajoutez un fichier « .env.local » (non versionné) qui surcharge .env pour SMTP
#   (Mailtrap, etc.). Chargé uniquement sur localhost / 127.0.0.1 ou en CLI.
# — Hôte type http://monprojet.test ou IP locale : mettez SAMAPIECE_LOAD_DOTENV_LOCAL=1 dans .env
#   pour forcer le chargement de .env.local.

SAMAPIECE_SMTP_HOST=goo-bridge.com
SAMAPIECE_SMTP_PORT=465
SAMAPIECE_SMTP_ENCRYPTION=ssl
SAMAPIECE_SMTP_USER=samapiece-noreply@goo-bridge.com
SAMAPIECE_SMTP_PASSWORD=
SAMAPIECE_EMAIL_FROM=samapiece-noreply@goo-bridge.com

# Si la connexion SSL échoue en local (certificat), essayez : SAMAPIECE_SMTP_SSL_VERIFY=0
# SAMAPIECE_LOAD_DOTENV_LOCAL=1
