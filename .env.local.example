# Copiez en « .env.local » à la racine de samapiece_php (non versionné).
# Surcharge .env uniquement sur votre machine (localhost / CLI).
# Exemple : identifiants Mailtrap ou SMTP de test.

# SAMAPIECE_SMTP_HOST=sandbox.smtp.mailtrap.io
# SAMAPIECE_SMTP_PORT=2525
# SAMAPIECE_SMTP_ENCRYPTION=tls
# SAMAPIECE_SMTP_USER=votre_user_mailtrap
# SAMAPIECE_SMTP_PASSWORD=votre_pass_mailtrap
# SAMAPIECE_EMAIL_FROM=test@example.com
